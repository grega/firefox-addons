{
  "manifest_version": 3,
  "name": "Remove Sponsored Content",
  "version": "2.2",
  "description": "Removes sponsored and promoted content from Amazon search results and Reddit feeds.",
  "browser_specific_settings": {
    "gecko": {
      "id": "remove-amazon-sponsored@gregannandale.com",
      "strict_min_version": "137.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.co.uk/*",
        "*://*.amazon.com/*",
        "*://*.reddit.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
